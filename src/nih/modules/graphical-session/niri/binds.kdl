binds {
  Ctrl+Alt+End { quit; }
  Ctrl+Alt+R {
    spawn "localectl" "set-x11-keymap" "--no-ask-password" "--no-convert" "us,ru"
  }
  Ctrl+Alt+S {
    spawn "localectl" "set-x11-keymap" "--no-ask-password" "--no-convert" "sk,ru"
  }
  Ctrl+Alt+G {
    spawn "localectl" "set-x11-keymap" "--no-ask-password" "--no-convert" "ge,ru,us"
  }

  Mod+Space { switch-layout "next"; }

  Mod+O repeat=false { toggle-overview; }

  Mod+J { focus-column-or-monitor-left; }
  Mod+K { focus-column-or-monitor-right; }
  Mod+I { focus-window-or-workspace-down; }
  Mod+U { focus-window-or-workspace-up; }

  Mod+Ctrl+K { focus-monitor-next; }
  Mod+Ctrl+I { power-off-monitors; }

  Mod+Shift+Q { close-window; }
  Mod+Shift+U { move-column-left; }
  Mod+Shift+J { move-column-right; }
  Mod+Shift+C { center-visible-columns; }
  Mod+Shift+E { expand-column-to-available-width; }
  Mod+Shift+F { fullscreen-window; }
  Mod+Shift+A { maximize-column; }
  Mod+Shift+T { toggle-window-floating; }
  Mod+Shift+V { center-column; }
  Mod+Shift+W { switch-preset-column-width; }

  Print { screenshot; }
  Ctrl+Print { screenshot-screen; }
  Alt+Print { screenshot-window; }
}
